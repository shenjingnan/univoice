{
  "name": "univoice",
  "version": "0.0.1",
  "description": "Unified Voice SDK for TTS and ASR",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./tts": {
      "import": "./dist/src/tts/index.js",
      "types": "./dist/src/tts/index.d.ts",
      "default": "./dist/src/tts/index.js"
    },
    "./asr": {
      "import": "./dist/src/asr/index.js",
      "types": "./dist/src/asr/index.d.ts",
      "default": "./dist/src/asr/index.js"
    },
    "./types": {
      "import": "./dist/types/index.d.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && pnpm copy-types",
    "copy-types": "node -e \"require('fs').cpSync('types', 'dist/types', {recursive: true})\"",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "spell": "cspell lint .",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "keywords": ["tts", "asr", "voice", "speech", "audio"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^25.3.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "cspell": "^8.0.0",
    "release-it": "^18.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ws": "^8.19.0"
  }
}
