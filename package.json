{
  "name": "univoice",
  "version": "0.1.0-beta.0",
  "description": "Unified Voice SDK for TTS and ASR",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenjingnan/univoice.git"
  },
  "author": "shenjingnan <sjn.code@gmail.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./tts": {
      "import": "./dist/src/tts/index.js",
      "types": "./dist/src/tts/index.d.ts",
      "default": "./dist/src/tts/index.js"
    },
    "./asr": {
      "import": "./dist/src/asr/index.js",
      "types": "./dist/src/asr/index.d.ts",
      "default": "./dist/src/asr/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "spell": "cspell lint .",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta",
    "release:dry": "release-it --dry-run",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "keywords": ["tts", "asr", "voice", "speech", "audio"],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^25.3.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "cspell": "^8.0.0",
    "release-it": "^18.0.0",
    "@release-it/conventional-changelog": "^10.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ws": "^8.19.0"
  }
}
